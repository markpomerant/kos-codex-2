# The codex runs against the KOS Studio backend, like the previous codex did.
# These are read by the SDK at runtime (process.env.KOS_*), so the Storybook
# config passes them through Vite's define (see .storybook/main.ts).
KOS_PORT=10010
KOS_ALLOW_ANONYMOUS=true
KOS_MOCK_WS=false
KOS_LOG_WS=false
KOS_USE_FOS=false
KOS_FOS_PORT=9854
KOS_USE_MOCK=false
