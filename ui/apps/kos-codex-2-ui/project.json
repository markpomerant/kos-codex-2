{
  "name": "kos-codex-2-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/kos-codex-2-ui/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "compiler": "babel",
        "outputPath": "dist/apps/kos-codex-2-ui",
        "index": "apps/kos-codex-2-ui/src/index.html",
        "baseHref": "/",
        "main": "apps/kos-codex-2-ui/src/main.ts",
        "tsConfig": "apps/kos-codex-2-ui/tsconfig.app.json",
        "assets": [
          "apps/kos-codex-2-ui/src/favicon.ico",
          "apps/kos-codex-2-ui/src/assets"
        ],
        "styles": [],
        "scripts": [],
        "webpackConfig": "apps/kos-codex-2-ui/webpack.config.ts",
        "skipTypeChecking": true,
        "_skipTypeCheckingTodo": "Remove once `nx run-many --target=typecheck` is clean."
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true,
          "vendorChunk": true
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/kos-codex-2-ui/src/environments/environment.ts",
              "with": "apps/kos-codex-2-ui/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false,
          "baseHref": "./"
        }
      }
    },
    "serve": {
      "executor": "@nx/react:module-federation-dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "kos-codex-2-ui:build",
        "hmr": false,
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "kos-codex-2-ui:build:development"
        },
        "production": {
          "buildTarget": "kos-codex-2-ui:build:production",
          "hmr": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "executor": "@nx/react:module-federation-static-server",
      "defaultConfiguration": "production",
      "options": {
        "serveTarget": "kos-codex-2-ui:serve"
      },
      "configurations": {
        "development": {
          "serveTarget": "kos-codex-2-ui:serve:development"
        },
        "production": {
          "serveTarget": "kos-codex-2-ui:serve:production"
        }
      }
    },
    "kab": {
      "command": "node tools/scripts/kabtool.mjs build kos-codex-2-ui && node tools/scripts/kabtool.mjs list kos-codex-2-ui ",
      "options": {
        "outputPath": "{projectRoot}/target/",
        "zipName": "ui.zip",
        "kabName": "kos-codex-2-ui.kab"
      },
      "dependsOn": [
        "zip"
      ]
    },
    "zip": {
      "command": "node tools/scripts/archiver.js kos-codex-2-ui",
      "options": {
        "outputPath": "{projectRoot}/target/",
        "zipName": "ui.zip"
      },
      "dependsOn": [
        "build",
        "descriptor",
        "sbom"
      ]
    },
    "descriptor": {
      "command": "node tools/scripts/descriptor.mjs kos-codex-2-ui",
      "options": {
        "outputPath": "dist/{projectRoot}",
        "fileName": "descriptor.json"
      },
      "dependsOn": [
        "build"
      ]
    },
    "version": {
      "command": "node tools/scripts/update-release-version.mjs kos-codex-2-ui {args.ver}",
      "options": {},
      "dependsOn": []
    },
    "sbom": {
      "executor": "@kosdev-code/kos-nx-plugin:sbom",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}/sbom.spdx.json",
        "{workspaceRoot}/dist/{projectRoot}/sbom.cyclonedx.json"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/package-lock.json"
      ],
      "options": {
        "outputPath": "dist/{projectRoot}",
        "softFail": true
      }
    },
    "typecheck": {
      "command": "tsc --noEmit -p {projectRoot}/tsconfig.app.json"
    },
    "storybook": {
      "command": "storybook dev -p 4400 -c apps/kos-codex-2-ui/.storybook",
      "dependsOn": [
        "extract"
      ]
    },
    "build-storybook": {
      "command": "storybook build -c apps/kos-codex-2-ui/.storybook -o dist/storybook/kos-codex-2",
      "outputs": [
        "{workspaceRoot}/dist/storybook/kos-codex-2"
      ],
      "dependsOn": [
        "extract"
      ]
    },
    "extract": {
      "command": "node node_modules/@matrica-code/snippet-extractor/extractSnippets.mjs --reset --snippetFile=apps/kos-codex-2-ui/public/snippets.json libs/core-concept-models/src libs/dispense-concept-models/src libs/model-components/src apps/kos-codex-2-ui/src/app",
      "outputs": [
        "{workspaceRoot}/apps/kos-codex-2-ui/public/snippets.json"
      ]
    }
  }
}
